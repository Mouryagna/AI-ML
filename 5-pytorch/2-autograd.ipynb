   "source": [
    "n=int(input(\"Enter your number: \"))\n",
    "remainder=0\n",
    "final=0\n",
    "a=n\n",
    "while(n!=0):\n",
    "    remainder=n%10\n",
    "    final=final*10+remainder\n",
    "    n=n//10\n",
    "\n",
    "print(final)"
   ],
